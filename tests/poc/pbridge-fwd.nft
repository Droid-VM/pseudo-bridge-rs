# pbridge offload ruleset — fwd mode(參考實作)。HOSTMAC=02:00:00:00:00:01,
# inner=fwd0、upstream=up0、channel=chan_in/chan_out。
# 風格:每條規則 = 匹配(在前) + 做一堆事(mangle 鏈) + 一個 terminal verdict。
# 規則「順序 = 優先序」(host 放行排在 entry demux 前);沒命中就 continue 到下一條。
table netdev pbridge {
    # ── 狀態(reconciler / sync_from_kernel_entry 維護)──
    map ip2mac4 { type ipv4_addr : ether_addr ; }                 # in demux: dst-ip → guest mac
    map ip2mac6 { type ipv6_addr : ether_addr ; }
    set valid4  { type ipv4_addr . ether_addr ; }                 # out 比對: (srcip,srcmac) 已知
    set valid6  { type ipv6_addr . ether_addr ; }
    set host4   { type ipv4_addr ; }                              # host 自己的 IP(放行用)
    set host6   { type ipv6_addr ; }
    set seen4   { type ipv4_addr ; flags dynamic ; timeout 30s ; } # liveness(kernel 自動老化)
    set seen6   { type ipv6_addr ; flags dynamic ; timeout 30s ; }

    # ── OUT: guest → up0(fwd0 ingress)──
    chain from_inner {
        type filter hook ingress device "fwd0" priority -300 ; policy accept ;

        ether saddr 02:00:00:00:00:01 drop                                          # host 偽裝/迴圈

        udp sport 68 udp dport 67 @th,144,16 set 0x8000 udp checksum set 0 \
            ether saddr set 02:00:00:00:00:01 fwd to "up0"                          # modify_dhcpv4

        ip saddr . ether saddr @valid4 update @seen4 { ip saddr } \
            ether saddr set 02:00:00:00:00:01 fwd to "up0"                          # 已知 v4 → offload

        ip6 saddr . ether saddr @valid6 ip6 nexthdr != 58 update @seen6 { ip6 saddr } \
            ether saddr set 02:00:00:00:00:01 fwd to "up0"                          # 已知 v6(非 ND)→ offload

        fwd to "chan_out"                                                            # ARP/ND/未知 → rust
    }

    # ── IN: up0 → guest(up0 ingress)──
    chain from_upstream {
        type filter hook ingress device "up0" priority -300 ; policy accept ;

        ether daddr 02:00:00:00:00:01 ip  daddr @host4 accept                       # host 自己 v4 → host stack
        ether daddr 02:00:00:00:00:01 ip6 daddr @host6 accept                       # host 自己 v6
        arp daddr ip @host4 accept                                                   # host 自己的 ARP reply

        meta pkttype { broadcast, multicast } dup to "fwd0"                          # 廣播/多播(含廣播 DHCP-reply)→ guest;原續走 host stack

        ether daddr 02:00:00:00:00:01 ip daddr @ip2mac4 update @seen4 { ip daddr } \
            ether daddr set ip daddr map @ip2mac4 fwd to "fwd0"                      # 已知 v4 → demux offload

        ether daddr 02:00:00:00:00:01 ip6 daddr @ip2mac6 ip6 nexthdr != 58 update @seen6 { ip6 daddr } \
            ether daddr set ip6 daddr map @ip2mac6 fwd to "fwd0"                     # 已知 v6 → demux offload

        ether daddr 02:00:00:00:00:01 ether type arp fwd to "chan_in"                # guest ARP-reply → rust demux
        ether daddr 02:00:00:00:00:01 ip6 nexthdr 58 fwd to "chan_in"                # NA/ND → rust
        ether daddr 02:00:00:00:00:01 drop                                           # 其餘未知單播(無 entry)
        # 落到這 = PACKET_OTHERHOST 等 → policy accept(不碰)
    }

    # ── no-leak guard(up0 egress):任何非 HOSTMAC 的 src 出口都正規化 ──
    chain egress_guard {
        type filter hook egress device "up0" priority 0 ;
        ether saddr != 02:00:00:00:00:01 ether saddr set 02:00:00:00:00:01
    }
}
